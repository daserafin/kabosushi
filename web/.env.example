# Copy to .env.local (git-ignored) and fill in. Find the values in the dashboard under
# Project Settings → API Keys, or with: npx supabase projects api-keys --project-ref <ref>
# Only VITE_* variables reach the browser, and everything that reaches the browser is public.
# The publishable key is safe there ONLY because grants + RLS protect the data.
# Never put the secret / service_role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
