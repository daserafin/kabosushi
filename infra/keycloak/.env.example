# Copy to .env (git-ignored) and fill in. Compose reads .env automatically.

# ★ Public URL of Keycloak, https and no trailing slash.
KC_HOSTNAME=https://auth.example.com

# ★ Optional LAN-only URL for the admin console (e.g. a second NPM proxy host with an
# access list that only allows your LAN). Leave empty to use KC_HOSTNAME for admin too.
KC_HOSTNAME_ADMIN=

# ★ Long random strings, e.g. `openssl rand -base64 32`.
POSTGRES_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=temp-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# info, debug, warn...
KC_LOG_LEVEL=info

# --- nginx-proxy-manager proxy host for KC_HOSTNAME ---------------------------------
# Details:  scheme http, forward to keycloak (same-host network) or <host IP>, port 8080,
#           Block Common Exploits on. Websockets not needed.
# SSL:      Let's Encrypt cert, Force SSL, HTTP/2, HSTS.
# Advanced: Keycloak's login responses carry big cookies/headers, and nginx's default
#           buffers are too small for them ("502 upstream sent too big header"):
#
#   proxy_buffer_size       128k;
#   proxy_buffers           4 256k;
#   proxy_busy_buffers_size 256k;
#
#   # Only if KC_HOSTNAME_ADMIN is set: keep the admin console off the internet.
#   location /admin/ { return 403; }
#
# Only /realms/ and /resources/ need to be public: logins, tokens, SAML metadata and
# the login page's CSS/JS live there.
